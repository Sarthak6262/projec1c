#include <stdio.h>
#include <stdlib.h>
#include <time.h>

int main() {
    int random, guess;
    int no_of_guess = 0;

    // Seed the random number generator with the current time
    srand(time(NULL));

    printf("Welcome to the world of Guessing Numbers!\n");
    random = rand() % 100 + 1; // Generates a number between 1 and 100

    do {
        printf("\nPlease enter your guess (1 to 100): ");
        scanf("%d", &guess);
        no_of_guess++;

        if (guess < random) {
            printf("Guess a larger number.\n");
        } else if (guess > random) {
            printf("Guess a smaller number.\n");
        } else {
            printf("\n🎉 Congratulations! You guessed the number %d in %d attempts.\n",random, no_of_guess);
        }

    } while (guess != random);

    printf("Thank you for playing. Goodbye!\n");
    printf("Developed by: Sarthak Wakchaure\n");

    return 0;
}
